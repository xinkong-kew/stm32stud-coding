{
  "configurations": [
    {
      "name": "STM32F103（Keil ARMCLANG / AC6）",
      "includePath": [
        "${workspaceFolder}/user",
        "${workspaceFolder}/my_lib",
        "${workspaceFolder}/my_lib/font",
        "${workspaceFolder}/std_periph_driver/inc",
        "R:/stm32/ARM/ARMCLANG/include"
      ],
      "defines": [
        "STM32F10X_HD",
        "USE_STDPERIPH_DRIVER"
      ],
      "compilerPath": "R:/stm32/ARM/ARMCLANG/bin/armclang.exe",
      "compilerArgs": [
        "--target=arm-arm-none-eabi",
        "-mcpu=cortex-m3"
      ],
      "intelliSenseMode": "windows-clang-arm",
      "cStandard": "c99",
      "cppStandard": "c++11",
      "browse": {
        "path": [
          "${workspaceFolder}/user",
          "${workspaceFolder}/my_lib",
          "${workspaceFolder}/my_lib/font",
          "${workspaceFolder}/std_periph_driver/inc"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "excludePath": [
        "${workspaceFolder}/Objects",
        "${workspaceFolder}/DebugConfig",
        "${workspaceFolder}/my_lib/font/ttfttc"
      ]
    }
  ],
  "version": 4
}